{
  "name": "penguinpark/monad",
  "description": "A collection of PHP classes that implement monad-based operations",
  "type": "library",
  "license": "Apache-2.0",
  "autoload": {
    "psr-4": {
      "PenguinPark\\Monad\\": "src/",
      "PenguinPark\\Tests\\Monad\\": "tests/"
    }
  },
  "authors": [
    {
      "name": "Richard Vasquez",
      "homepage": "https://richardvasquez.com",
      "role": "Developer",
      "email": "github.com@callahansplace.org"
    }],
  "require": {
    "php": ">=8.3"
  },
  "require-dev": {
    "infection/infection": "^0.31.1",
    "phpunit/phpunit": "12.3"
  },
  "config": {
    "allow-plugins": {
      "infection/extension-installer": true
    }
  },
  "keywords": [
    "monad",
    "functor",
    "functional-programming",
    "maybe",
    "either",
    "validation",
    "io",
    "state",
    "reader" ],
  "scripts": {
    "test": "phpunit",
    "mutate": "infection --threads=4 --min-msi=100 --ansi"
  }
}
